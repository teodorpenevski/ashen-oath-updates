    {
      "id": "6DD88FAF41E54CBB",
      "title": "Return to Your Body",
      "description": [
        "Death leaves your dropped equipment inside your body. Return, right-click the corpse and transfer your items back.",
        "Only the owner can loot it. A full corpse never expires and is protected against lava and the void. keepInventory must be false.",
        "Test recovery with cheap items first. Tick this tutorial after learning the recovery controls."
      ],
      "optional": true,
      "x": -3.0,
