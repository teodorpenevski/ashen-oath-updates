    {
      "id": "3577A21A6539859F",
      "title": "Bind the Road",
      "description": [
        "Right-click your Earthbound Oath to activate the team riding license. This checks the actual server unlock; a traded or borrowed item cannot skip the exploration requirement. Tame and saddle your chosen mount normally."
      ],
