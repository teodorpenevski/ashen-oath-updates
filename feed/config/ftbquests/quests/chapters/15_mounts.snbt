    {
      "id": "7969FBE7D2C166D9",
      "title": "An Earthbound Oath",
      "description": [
        "Craft the Earthbound Oath from four leather, two iron ingots, two wheat and one string. Once your team has explored three different Overworld biomes, right-click the oath to consume it and earn permanent access to the added ground and aquatic mounts."
      ],
