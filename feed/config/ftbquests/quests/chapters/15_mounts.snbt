    {
      "id": "000B109BA95A2AF0",
      "title": "A Skybound Oath",
      "description": [
        "Craft a Skybound Oath with three phantom membranes, two feathers, two ender pearls, one diamond and one Earthbound Oath. Your team needs both ground riding and a qualifying boss victory before this item can grant flight."
      ],
