    {
      "id": "7FD4FF8BE577E177",
      "title": "Earn Your Wings",
      "description": [
        "Right-click the Skybound Oath to consume it and unlock the added flying mounts for your FTB team. Taming, saddles, ownership, terrain and each creature's normal flight controls still apply. Unlocks are saved with the team and survive death and reconnects."
      ],
