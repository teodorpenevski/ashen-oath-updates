    {
      "id": "38398EF0AF471C80",
      "title": "The Graybeard's First Staff",
      "description": [
        "Claim or craft a Graybeard Staff and compare its held attributes with your ordinary weapon. A staff supports your spellcasting, while the equipped spellbook supplies the spells themselves; keep both systems in mind when building your loadout."
      ],
