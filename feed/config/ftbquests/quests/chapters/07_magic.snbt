  "quests": [
    {
      "id": "2499ED72E62662F9",
      "title": "I · The First Spark",
      "description": [
        "An apprentice's journal is the beginning of a legend, not its limit. Follow the five stages from gathered essence to the Dead King, with optional school, alchemy, research and exploration branches along the way. Every class can learn magic; Ashen's separate level-10 class spell reward remains available."
      ],
      "x": -3.0,
      "y": 3.0,
