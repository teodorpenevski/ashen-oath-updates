          "count": 1
        }
      ],
      "dependencies": [
        "1AAD21527CC70AC3"
      ],
      "optional": true,
      "hide_until_deps_complete": false,
      "hide_until_deps_visible": false,
      "icon": "irons_spellbooks:cinderous_soulcaller"
    },
    {
      "id": "282E59B3C869C973",
      "title": "Recover Ancient Knowledge",
      "description": [
        "Collect 8 Ancient Knowledge Fragments. Examine their exploration and loot sources and keep them for research instead of discarding them as ordinary paper.",
        "You will also need an echo shard. The Ancient City route can overlap with finding a Ruined Book, but plan the trip around survival rather than carrying your whole workshop into the Deep Dark.",
        "Research is character progression separate from owning a scroll or equipping a school set. An unlearned Eldritch scroll is not fixed by simply upgrading your spellbook.",
        "Completion: carry the requested item in your normal inventory. Detection keeps your items; nothing is submitted or consumed. JEI shows this pack's exact recipes."
      ],
      "x": 74.0,
      "y": 0.0,
      "tasks": [
        {
          "id": "2E18DE298FF599AA",
          "type": "item",
