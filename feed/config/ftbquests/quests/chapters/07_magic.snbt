      "hide_until_deps_visible": false,
      "icon": "minecraft:poisonous_potato"
    },
    {
      "id": "01326AD1BBDEBAD3",
      "title": "The Arcane Anvil Workshop",
      "description": [
        "Craft the Arcane Anvil from amethyst blocks, a diamond, polished deepslate and a normal anvil. This installed version does not require netherite for the workstation itself.",
        "It handles scroll leveling, equipment upgrades, compatible imbuements, affinity attunement and some spellbook improvements. Put the item being changed on the left and the appropriate modifier on the right.",
        "Read the output preview before taking anything. This is not a conventional anvil-enchantment merge: each operation has its own accepted inputs and eligibility checks.",
        "Completion: carry the requested item in your normal inventory. Detection keeps your items; nothing is submitted or consumed. JEI shows this pack's exact recipes."
      ],
      "x": 22.0,
      "y": 8.0,
      "tasks": [
        {
          "id": "17CC849C9DE055AE",
          "type": "item",
          "item": "irons_spellbooks:arcane_anvil",
