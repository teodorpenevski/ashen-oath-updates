      ],
      "optional": true,
      "hide_until_deps_complete": false,
      "hide_until_deps_visible": false,
      "icon": "irons_spellbooks:alchemist_cauldron"
    },
    {
      "id": "23820CB3E3C3D0DA",
      "title": "Recycle Duplicate Scrolls",
      "description": [
        "Set aside a duplicate or unwanted scroll and inspect its Alchemist Cauldron use in JEI. Recycle that expendable scroll into ink rather than destroying your only copy of a spell you still need.",
        "Read the recipe's fluid requirements and resulting rarity. Collect the output with bottles and place it with your existing ink supply.",
        "Keep one useful copy of each spell and only recycle deliberate surplus. Unique items, unlearned Eldritch research and the Scroll Forge's available spells are separate systems; recycling does not automatically research anything.",
        "Completion: perform the practice described above, then tick this lesson manually. This is a tutorial acknowledgement, not automatic detection of a cast or upgrade."
      ],
      "x": 10.0,
      "y": 20.0,
      "tasks": [
        {
          "id": "1321F35EFD4FC710",
          "type": "checkmark"
        }
      ],
