    {
      "id": "760387861CE76416",
      "title": "A Book Worth Keeping",
      "description": [
        "Obtain a Flimsy Journal, registered as copper_spell_book, to hold reusable spells. The Mage starter kit already supplies one; all classes can also craft it or earn an inscribed core-spell journal at the pack's level-10 milestone. The Ironbound Tome is an alternative starting route, and either book unlocks the equipment lesson."
      ],
      "x": 4.0,
      "y": 0.0,
      "tasks": [
        {
          "id": "7C11464A08603334",
