    {
      "id": "69D8664D74C6073B",
      "title": "An Ironbound Tome",
      "description": [
        "Craft or find an Ironbound Tome as an alternative to beginning with a Flimsy Journal. Either early book unlocks the equipment lesson, and the Inscription Table lets you transfer ordinary spells if you later change books."
      ],
      "x": 4.0,
      "y": -2.0,
      "tasks": [
