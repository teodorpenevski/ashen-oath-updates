      ],
      "optional": true,
      "hide_until_deps_complete": false,
      "hide_until_deps_visible": false,
      "icon": "irons_spellbooks:scroll"
    },
    {
      "id": "3D7F97F24EE80923",
      "title": "Travel, Storage and Practical Magic",
      "description": [
        "Build a non-combat loadout and test utility spells appropriate to your progression: movement, Recall, Portal, Summon Ender Chest or a practical tool such as Spectral Hammer.",
        "Read each spell's anchor, targeting, duration and dimension restrictions before relying on it to bring valuables home. Carry a conventional fallback until you have tested the full round trip.",
        "Some utility features use special blocks or items, such as Portal Frames. Inspect their JEI recipes and tooltips; the questbook is teaching the system rather than automatically placing a working travel network for you.",
        "Completion: perform the practice described above, then tick this lesson manually. This is a tutorial acknowledgement, not automatic detection of a cast or upgrade."
      ],
      "x": 74.0,
      "y": 16.0,
      "tasks": [
