    {
      "id": "7B9B8EB1D400229C",
      "title": "The Hunting Ledger",
      "description": [
        "Choose any available encounter and read its preparation notes before fighting. First victories and veteran targets are one-time rewards; the five-kill contracts become repeatable after you claim their item rewards, and story seals still apply."
      ],
